# Copia este archivo como .env y cambia los valores

# Clave para firmar los tokens JWT (usa una larga y aleatoria)
JWT_SECRET=cambia-esta-clave-en-produccion-por-una-larga
JWT_MINUTOS=480

# Orígenes del frontend autorizados por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Usuarios que se crean la primera vez que arranca la API
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin123
DOCENTE_USUARIO=docente
DOCENTE_PASSWORD=docente123

# Carpeta de la base de datos, los modelos y los datasets subidos
STORAGE_DIR=storage
DATASET_INICIAL=data/StudentPerformanceFactors.csv
MAX_UPLOAD_MB=10
